# —— 登录方式 ——
# local = 工号＋平台口令（统一认证正式启用前使用，口令由体育部在“账号”页批量生成发放）
# sso   = 数字人大统一身份认证（学校 CAS 服务器上的 OAuth2.0 接口）
# 改完执行 systemctl restart pe-scores 生效
PE_AUTH_MODE=local

# —— 统一身份认证（PE_AUTH_MODE=sso 时必填下面三项，缺一项服务拒绝启动）——
# 学校应用中心为本平台注册的 appid
PE_SSO_CLIENT_ID=PnemSGKIdvULphrVpyjV-dep
# 与 appid 配套的 secret，只写在服务器上，不进代码仓库、不发聊天
PE_SSO_CLIENT_SECRET=
# 回调地址，必须与应用中心登记的一字不差（明文，不要 URL 编码）。登记的是根地址时直接填根地址
PE_SSO_REDIRECT_URI=https://pe.example.edu.cn
# 统一认证根地址，一般不用改；三个接口按它拼成 {根}/oauth2.0/authorize、accessToken、user/profiles
# PE_SSO_BASE_URL=https://cas.ruc.edu.cn/cas
# 允许登录的人员类别（学校返回的 categoryName），逗号分隔；管理员不受限
# PE_SSO_ALLOWED_CATEGORIES=教职工

# —— 其他 ——
# 初始管理员：学号或工号，逗号分隔。列在这里的人登录时自动成为体育部管理员，
# 不受“只放教职工登录”的限制。空库上线时用它指定第一个管理员，之后可在管理端“账号”页增减。
# 注意：列在这里的人在管理端取消不掉管理员身份，要撤掉先从这里删除再重启服务。
PE_ADMIN_STAFF_NOS=
PE_DATA_DIR=/data/pe-scores
PE_HTTPS_ONLY=1
