[Unit]
Description=体育成绩录入平台
After=network.target

[Service]
User=pe
Group=pe
WorkingDirectory=/opt/pe-scores/app
EnvironmentFile=/etc/pe-scores.env
ExecStart=/opt/pe-scores/app/.venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000 --workers 2 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
